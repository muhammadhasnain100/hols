# ---------- OpenRouter ----------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-5.5

# ---------- ChromaDB Cloud ----------
CHROMA_API_KEY=your-chroma-api-key
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=ai_adviser
CHROMA_COLLECTION=peptide_chunks
# true (default) | false (Windows SSL issues) | /path/to/ca.pem
CHROMA_SSL_VERIFY=true

# ---------- Embedding model (OpenRouter, hosted) ----------
EMBED_MODEL=perplexity/pplx-embed-v1-4b
EMBED_BATCH_SIZE=32

# ---------- Retrieval ----------
TOP_K=6
